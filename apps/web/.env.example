# Node backend. Browser requests stay on the web origin through Next.js rewrites.
API_BASE_URL=http://127.0.0.1:4100
# The public address, used in link previews and the sitemap. Read at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Cloudflare Turnstile site key, matching the API's TURNSTILE_SECRET_KEY. Read at build time;
# empty means no bot check (local runs and tests).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Sentry project for the web app. Read at build time; empty means no error reports.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
