{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "PriceCharm dedicated EC2 web/API host, its own private RDS MariaDB database, private photos and database backups, restricted SES role, a GitHub deploy role and alarms. Shares nothing with other applications.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Public subnet for the application host; outbound internet required."
    },
    "KeyName": {
      "Type": "AWS::EC2::KeyPair::KeyName"
    },
    "SshCidr": {
      "Type": "String",
      "Default": "127.0.0.1/32",
      "AllowedPattern": "\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}",
      "Description": "Optional administrator SSH source CIDR. The default keeps SSH closed; use Session Manager instead. GitHub deploys open and close their own access."
    },
    "GitHubRepository": {
      "Type": "String",
      "Default": "Mitchell-Marchand/pricecharm-hackathon",
      "AllowedPattern": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+",
      "Description": "owner/name of the GitHub repository whose production environment may deploy."
    },
    "GitHubOidcProviderArn": {
      "Type": "String",
      "Default": "",
      "Description": "Leave empty to create the GitHub sign-in provider. If this AWS account already has one for token.actions.githubusercontent.com, paste its ARN here."
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.medium",
      "AllowedValues": [
        "t3.small",
        "t3.medium",
        "t3.large",
        "m6i.large"
      ]
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "SesIdentityArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws[a-z-]*:ses:[a-z0-9-]+:\\d{12}:identity/.+",
      "Description": "Verified SES sending domain identity ARN in this AWS region."
    },
    "DatabaseMode": {
      "Type": "String",
      "Default": "dedicated",
      "AllowedValues": [
        "dedicated",
        "existing"
      ],
      "Description": "dedicated creates a private RDS MariaDB instance for PriceCharm only (recommended). existing keeps the older option of reaching a database you already run."
    },
    "DbSubnetIds": {
      "Type": "CommaDelimitedList",
      "Default": "",
      "Description": "Dedicated database only: two or more private subnets in different Availability Zones, comma separated."
    },
    "DbInstanceClass": {
      "Type": "String",
      "Default": "db.t4g.small",
      "AllowedValues": [
        "db.t4g.micro",
        "db.t4g.small",
        "db.t4g.medium",
        "db.t4g.large",
        "db.m7g.large"
      ]
    },
    "DbAllocatedStorage": {
      "Type": "Number",
      "Default": 20,
      "MinValue": 20,
      "MaxValue": 1000,
      "Description": "Initial storage in GiB."
    },
    "DbMaxAllocatedStorage": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 21,
      "MaxValue": 2000,
      "Description": "Storage autoscaling ceiling in GiB. Must be larger than DbAllocatedStorage."
    },
    "DbEngineVersion": {
      "Type": "String",
      "Default": "11.4",
      "AllowedValues": [
        "11.4"
      ],
      "Description": "MariaDB major version. The parameter group family follows it."
    },
    "DbMultiAz": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "true keeps a standby in a second Availability Zone (about double the cost)."
    },
    "DbBackupRetentionDays": {
      "Type": "Number",
      "Default": 14,
      "MinValue": 1,
      "MaxValue": 35
    },
    "ExistingDbSecurityGroupId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|sg-[a-f0-9]+)",
      "Description": "Only used when DatabaseMode is existing: adds TCP 3306 from the app host to this database security group. Not recommended; see docs/ops/database.md."
    },
    "AlarmTopicArn": {
      "Type": "String",
      "Default": "",
      "Description": "Optional existing SNS topic ARN for host alarms."
    }
  },
  "Conditions": {
    "HasDbGroup": {
      "Fn::And": [
        {
          "Fn::Not": [
            {
              "Condition": "CreateDatabase"
            }
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "ExistingDbSecurityGroupId"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "HasAlarmTopic": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlarmTopicArn"
            },
            ""
          ]
        }
      ]
    },
    "CreateDatabase": {
      "Fn::Equals": [
        {
          "Ref": "DatabaseMode"
        },
        "dedicated"
      ]
    },
    "DbMultiAzEnabled": {
      "Fn::Equals": [
        {
          "Ref": "DbMultiAz"
        },
        "true"
      ]
    },
    "CreateGitHubOidcProvider": {
      "Fn::Equals": [
        {
          "Ref": "GitHubOidcProviderArn"
        },
        ""
      ]
    }
  },
  "Resources": {
    "AppSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Quotient HTTPS plus restricted SSH; app ports remain loopback only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "SshCidr"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "quotient"
          }
        ]
      }
    },
    "DeploySshSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "SSH for GitHub deploys only; each deploy adds its own address and removes it",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "quotient"
          }
        ]
      }
    },
    "DbIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Condition": "HasDbGroup",
      "Properties": {
        "GroupId": {
          "Ref": "ExistingDbSecurityGroupId"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "SourceSecurityGroupId": {
          "Ref": "AppSecurityGroup"
        },
        "Description": "PriceCharm application access to an existing database (DatabaseMode existing)"
      }
    },
    "PhotoBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "PhotoBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "PhotoBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "PhotoBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${PhotoBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire-database-dumps",
              "Status": "Enabled",
              "ExpirationInDays": 28,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      }
    },
    "BackupBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "BackupBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "BackupBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${BackupBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "AppRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "ec2.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "quotient-runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${PhotoBucket.Arn}/quotient/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ses:SendEmail"
                  ],
                  "Resource": {
                    "Ref": "SesIdentityArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${BackupBucket.Arn}/database/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "AppRole"
          }
        ]
      }
    },
    "GitHubOidcProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Condition": "CreateGitHubOidcProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ],
        "ThumbprintList": [
          "6938fd4d98bab03faadb97b34396831e3780aea1",
          "1c58a3a8518e8759bf075b76b750d4f2df264fcd"
        ]
      }
    },
    "DeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "GitHub production deploys: open and close SSH for the runner, nothing else",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "CreateGitHubOidcProvider",
                    {
                      "Ref": "GitHubOidcProvider"
                    },
                    {
                      "Ref": "GitHubOidcProviderArn"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:${GitHubRepository}:environment:production"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "quotient-deploy-ssh",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:AuthorizeSecurityGroupIngress",
                    "ec2:RevokeSecurityGroupIngress"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:security-group/${DeploySshSecurityGroup.GroupId}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:security-group-rule/*"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "quotient"
          }
        ]
      }
    },
    "AppInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "KeyName": {
          "Ref": "KeyName"
        },
        "SubnetId": {
          "Ref": "SubnetId"
        },
        "SecurityGroupIds": [
          {
            "Ref": "AppSecurityGroup"
          },
          {
            "Ref": "DeploySshSecurityGroup"
          }
        ],
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "Monitoring": true,
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 30,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/usr/bin/env bash\n# Amazon Linux 2023, a new instance just for PriceCharm. Run as root, or paste it in as the\n# instance's user data at launch.\nset -euo pipefail\n[[ $(id -u) == 0 ]] || { echo 'Run on a new EC2 instance as root.' >&2; exit 1; }\nsource /etc/os-release\n[[ \"$ID\" == amzn && \"$VERSION_ID\" == 2023 ]] || { echo 'This bootstrap requires Amazon Linux 2023.' >&2; exit 1; }\ndnf install -y nodejs24 nodejs24-npm nginx rsync jq mariadb105 gzip python3 amazon-cloudwatch-agent certbot docker openssl nano\nalternatives --set node /usr/bin/node-24\n[[ $(node -p 'process.versions.node.split(\".\")[0]') == 24 ]]\nnpm install --global pm2@6\nid quotient >/dev/null 2>&1 || useradd --create-home --shell /bin/bash quotient\ninstall -d -m 700 -o quotient -g quotient /home/quotient/.ssh\ninstall -d -m 755 -o quotient -g quotient /srv/quotient-api/releases /srv/quotient-web/releases\ninstall -d -m 700 -o quotient -g quotient /srv/quotient-api/shared /srv/quotient-api/shared/uploads /srv/quotient-api/shared/backups\n# The deployment user gets its own key, added after launch (LAUNCH.md). The instance admin key\n# stays with ec2-user, which can sudo, so it never needs to be stored in GitHub.\ntouch /home/quotient/.ssh/authorized_keys\nchown quotient:quotient /home/quotient/.ssh/authorized_keys\nchmod 600 /home/quotient/.ssh/authorized_keys\npm2 startup systemd -u quotient --hp /home/quotient\ncat > /etc/logrotate.d/quotient <<'ROTATE'\n/home/quotient/.pm2/logs/*.log {\n    daily\n    rotate 14\n    compress\n    missingok\n    notifempty\n    copytruncate\n    su quotient quotient\n}\nROTATE\n# PriceCharm's database: MariaDB 11.4, the version CI tests against, in Docker on this host and\n# reachable only from it. The root password stays in /root/pricecharm/mariadb.env.\nsystemctl enable --now docker\ninstall -d -m 700 /srv/mariadb /root/pricecharm\nif [[ ! -s /root/pricecharm/mariadb.env ]]; then\n  (umask 077 && printf 'MARIADB_ROOT_PASSWORD=%s\\nMARIADB_ROOT_HOST=localhost\\nMARIADB_AUTO_UPGRADE=1\\n' \"$(openssl rand -hex 24)\" > /root/pricecharm/mariadb.env)\nfi\ndocker container inspect pricecharm-db >/dev/null 2>&1 || docker run --detach --name pricecharm-db \\\n  --restart unless-stopped --env-file /root/pricecharm/mariadb.env \\\n  --publish 127.0.0.1:3306:3306 --volume /srv/mariadb:/var/lib/mysql mariadb:11.4\nfor attempt in $(seq 1 60); do\n  docker exec pricecharm-db healthcheck.sh --connect --innodb_initialized >/dev/null 2>&1 && break\n  [[ $attempt -lt 60 ]] || { echo 'MariaDB did not start; see docker logs pricecharm-db.' >&2; exit 1; }\n  sleep 2\ndone\n# The first run makes the database, a rows-only app user and a migration user, and writes their\n# settings into shared/migrate.env and the top of shared/.env. Later runs leave both alone.\nif [[ ! -f /srv/quotient-api/shared/.env ]]; then\n  app_password=$(openssl rand -hex 24)\n  migrate_password=$(openssl rand -hex 24)\n  docker exec -i pricecharm-db sh -c 'MYSQL_PWD=\"$MARIADB_ROOT_PASSWORD\" mariadb -uroot' <<SQL\nCREATE DATABASE IF NOT EXISTS quotient_production CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\nCREATE OR REPLACE USER 'quotefolk_app'@'%' IDENTIFIED BY '$app_password' WITH MAX_USER_CONNECTIONS 20;\nGRANT SELECT, INSERT, UPDATE, DELETE ON quotient_production.* TO 'quotefolk_app'@'%';\nCREATE OR REPLACE USER 'quotefolk_migrate'@'%' IDENTIFIED BY '$migrate_password' WITH MAX_USER_CONNECTIONS 2;\nGRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, REFERENCES, DROP ON quotient_production.* TO 'quotefolk_migrate'@'%';\nSQL\n  install -m 600 -o quotient -g quotient /dev/null /srv/quotient-api/shared/migrate.env\n  printf 'MIGRATION_DB_USER=quotefolk_migrate\\nMIGRATION_DB_PASS=%s\\n' \"$migrate_password\" > /srv/quotient-api/shared/migrate.env\n  install -m 600 -o quotient -g quotient /dev/null /srv/quotient-api/shared/.env\n  cat > /srv/quotient-api/shared/.env <<ENV\n# PriceCharm's database on this server, written by bootstrap-ec2.sh.\n# Add everything from apps/api/deploy/env.production.example below these lines.\nDB_HOST=127.0.0.1\nDB_PORT=3306\nDB_NAME=quotient_production\nDB_USER=quotefolk_app\nDB_PASS=$app_password\nDB_CONNECTION_LIMIT=5\n\nENV\nfi\n# HTTPS certificates: Nginx serves the ACME challenge from /var/www/acme (nginx-site.conf.example),\n# certbot's timer renews twice a day, and Nginx reloads whenever a certificate changes.\ninstall -d -m 755 /var/www/acme /etc/letsencrypt/renewal-hooks/deploy\nprintf '%s\\n' '#!/bin/sh' 'systemctl reload nginx' > /etc/letsencrypt/renewal-hooks/deploy/reload-nginx\nchmod 755 /etc/letsencrypt/renewal-hooks/deploy/reload-nginx\n# Nightly database dump, kept on this server for a week and copied to BACKUP_BUCKET when that's\n# set. It waits until the first API release exists.\ncat > /etc/systemd/system/quotient-backup.service <<'UNIT'\n[Unit]\nDescription=PriceCharm database backup\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nUser=quotient\nGroup=quotient\nExecCondition=/usr/bin/test -f /srv/quotient-api/current/apps/api/deploy/ops/nightly-backup.sh\nExecStart=/bin/bash /srv/quotient-api/current/apps/api/deploy/ops/nightly-backup.sh\nUNIT\ncat > /etc/systemd/system/quotient-backup.timer <<'UNIT'\n[Unit]\nDescription=Nightly PriceCharm database backup\n\n[Timer]\nOnCalendar=*-*-* 08:00:00 UTC\nRandomizedDelaySec=30m\nPersistent=true\n\n[Install]\nWantedBy=timers.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now nginx amazon-ssm-agent certbot-renew.timer quotient-backup.timer\nprintf '%s\\n' 'Bootstrap complete. Add the deploy key, finish shared/.env (the database lines are already in it), set up DNS and HTTPS; then deploy the API and web releases.'\n"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "quotient"
          },
          {
            "Key": "Application",
            "Value": "quotient"
          }
        ]
      }
    },
    "ElasticIp": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "InstanceId": {
          "Ref": "AppInstance"
        }
      }
    },
    "CpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Quotient host requires operator attention",
        "Namespace": "AWS/EC2",
        "MetricName": "CPUUtilization",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "AppInstance"
            }
          }
        ],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 3,
        "Threshold": 85,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "missing",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "InstanceStatusAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Quotient host requires operator attention",
        "Namespace": "AWS/EC2",
        "MetricName": "StatusCheckFailed",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "AppInstance"
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "missing",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "DbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Condition": "CreateDatabase",
      "Properties": {
        "GroupDescription": "PriceCharm database: MariaDB from the PriceCharm application host only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3306,
            "ToPort": 3306,
            "SourceSecurityGroupId": {
              "Ref": "AppSecurityGroup"
            },
            "Description": "PriceCharm API and worker"
          }
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "quotient"
          }
        ]
      }
    },
    "DbSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Condition": "CreateDatabase",
      "Properties": {
        "DBSubnetGroupDescription": "Private subnets for the PriceCharm database",
        "SubnetIds": {
          "Ref": "DbSubnetIds"
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "quotient"
          }
        ]
      }
    },
    "DbParameterGroup": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Condition": "CreateDatabase",
      "Properties": {
        "Description": "PriceCharm MariaDB: TLS required, utf8mb4",
        "Family": {
          "Fn::Sub": "mariadb${DbEngineVersion}"
        },
        "Parameters": {
          "require_secure_transport": "ON",
          "character_set_server": "utf8mb4",
          "collation_server": "utf8mb4_unicode_ci"
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "quotient"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Condition": "CreateDatabase",
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot",
      "Properties": {
        "Engine": "mariadb",
        "EngineVersion": {
          "Ref": "DbEngineVersion"
        },
        "DBInstanceClass": {
          "Ref": "DbInstanceClass"
        },
        "AllocatedStorage": {
          "Ref": "DbAllocatedStorage"
        },
        "MaxAllocatedStorage": {
          "Ref": "DbMaxAllocatedStorage"
        },
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MultiAZ": {
          "Fn::If": [
            "DbMultiAzEnabled",
            true,
            false
          ]
        },
        "DBName": "quotient_production",
        "MasterUsername": "quotefolk_admin",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "DbSubnetGroup"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DbSecurityGroup"
          }
        ],
        "DBParameterGroupName": {
          "Ref": "DbParameterGroup"
        },
        "PubliclyAccessible": false,
        "BackupRetentionPeriod": {
          "Ref": "DbBackupRetentionDays"
        },
        "DeletionProtection": true,
        "CopyTagsToSnapshot": true,
        "AutoMinorVersionUpgrade": true,
        "EnableCloudwatchLogsExports": [
          "error"
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "quotient"
          }
        ]
      }
    },
    "DbCpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "CreateDatabase",
      "Properties": {
        "AlarmDescription": "PriceCharm database CPU has stayed high",
        "Namespace": "AWS/RDS",
        "MetricName": "CPUUtilization",
        "Dimensions": [
          {
            "Name": "DBInstanceIdentifier",
            "Value": {
              "Ref": "Database"
            }
          }
        ],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 3,
        "Threshold": 80,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "missing",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "DbStorageAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "CreateDatabase",
      "Properties": {
        "AlarmDescription": "PriceCharm database has less than 2 GiB of free storage",
        "Namespace": "AWS/RDS",
        "MetricName": "FreeStorageSpace",
        "Dimensions": [
          {
            "Name": "DBInstanceIdentifier",
            "Value": {
              "Ref": "Database"
            }
          }
        ],
        "Statistic": "Minimum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 2147483648,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "missing",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "DbConnectionsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "CreateDatabase",
      "Properties": {
        "AlarmDescription": "PriceCharm database connections are close to the app and migration limits",
        "Namespace": "AWS/RDS",
        "MetricName": "DatabaseConnections",
        "Dimensions": [
          {
            "Name": "DBInstanceIdentifier",
            "Value": {
              "Ref": "Database"
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 18,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "missing",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "AppInstance"
      }
    },
    "PublicIp": {
      "Value": {
        "Ref": "ElasticIp"
      }
    },
    "SecurityGroupId": {
      "Value": {
        "Ref": "AppSecurityGroup"
      }
    },
    "DeploySecurityGroupId": {
      "Description": "GitHub variable EC2_DEPLOY_SECURITY_GROUP_ID",
      "Value": {
        "Ref": "DeploySshSecurityGroup"
      }
    },
    "DeployRoleArn": {
      "Description": "GitHub variable AWS_DEPLOY_ROLE_ARN",
      "Value": {
        "Fn::GetAtt": [
          "DeployRole",
          "Arn"
        ]
      }
    },
    "PhotoBucket": {
      "Value": {
        "Ref": "PhotoBucket"
      }
    },
    "BackupBucket": {
      "Description": "BACKUP_BUCKET in shared/.env",
      "Value": {
        "Ref": "BackupBucket"
      }
    },
    "DeployUser": {
      "Value": "quotient"
    },
    "DatabaseEndpoint": {
      "Condition": "CreateDatabase",
      "Description": "DB_HOST for the API",
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "DatabasePort": {
      "Condition": "CreateDatabase",
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Port"
        ]
      }
    },
    "DatabaseAdminSecretArn": {
      "Condition": "CreateDatabase",
      "Description": "Secrets Manager secret holding the admin password. Use it only to create the app and migration users.",
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "MasterUserSecret.SecretArn"
        ]
      }
    }
  }
}