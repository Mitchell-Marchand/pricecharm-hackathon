# Template for /srv/quotient-api/shared/.env on a staging or production server (owner quotient, mode 600).
# bootstrap-ec2.sh already wrote the database settings at the top of that file. Paste everything below
# after them. The API refuses to start when a required value is missing or unsafe. Never commit a
# filled-in copy.

# production, or staging (staging must use a Stripe test key).
APP_ENV=production
NODE_ENV=production
HOST=127.0.0.1
PORT=4100
APP_ORIGIN=https://pricecharm.com
PUBLIC_APP_URL=https://pricecharm.com
# Exactly one reverse proxy (Nginx on this host) sits in front of the API.
TRUST_PROXY=1

# The database settings (DB_HOST, DB_NAME, DB_USER, DB_PASS) are the ones bootstrap-ec2.sh wrote.
# Don't add them again here: a later, empty DB_PASS would replace the real one.

# AI: keys that belong to PriceCharm only. See docs/ops/ai-keys.md.
AI_PROVIDER=meta
# Standard-mode models only, never -contributor ones.
META_API_KEY=
META_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: a stronger model just for drafting quotes, picked with `npm run replay`.
META_DRAFT_MODEL=
OPENAI_DRAFT_MODEL=
ANTHROPIC_DRAFT_MODEL=
# Other businesses' combined rates as a starting price. off turns it off.
MARKET_PRICES=on
AI_DAILY_APP_LIMIT=1000
AI_DAILY_BUSINESS_LIMIT=200
# Customer chat has its own allowances, so it can't use up what owners need for training.
AI_DAILY_CUSTOMER_APP_LIMIT=600
AI_DAILY_BUSINESS_CUSTOMER_LIMIT=200
AI_DAILY_CUSTOMER_IP_LIMIT=60
# Setups that haven't signed up yet share their own pool, and each has a lifetime cap.
AI_DAILY_DRAFT_APP_LIMIT=400
AI_DRAFT_LIFETIME_LIMIT=220
# The live demo on the marketing site: all visitors together, and each visitor, per day.
# Each demo chat is also capped at 12 calls.
AI_DAILY_DEMO_LIMIT=300
AI_DAILY_DEMO_IP_LIMIT=40

# Email goes out through Amazon SES. AWS_REGION is the region where pricecharm.com is verified;
# the server's IAM role is what lets it send, so there are no AWS keys here. SES_EMAIL_FROM is just
# the address: inboxes show "PriceCharm", or the business's name on emails to its customers.
MAIL_PROVIDER=ses
SES_EMAIL_FROM=quotes@pricecharm.com
AWS_REGION=us-east-1
# 32 random bytes, base64. Back it up: queued emails can't be read without it.
MAIL_ENCRYPTION_KEY=

# Every Stripe value comes from the same mode: all test in staging, all live in production.
# COMMERCE.md has the exact setup.
BILLING_PROVIDER=stripe
# A live key (sk_live_ or rk_live_) in production, a test key in staging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# `npm run stripe:setup` creates the meter and prices below and prints these lines.
STRIPE_METER_EVENT_NAME=pricecharm_quotes
# $2.00 a quote, $0 a quote (the accepted-quote plan) and $1.00 a quote past the allowance, all
# on the meter above.
STRIPE_PRICE_PER_QUOTE=
STRIPE_PRICE_PER_ACCEPTED=
STRIPE_PRICE_EXTRA_QUOTES=
# The subscription plans: $49.00 a month and $499.00 a year. Checkout refuses a price whose
# amount doesn't match the pricing page.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# WhatsApp, from the PriceCharm app on developers.facebook.com. Empty keeps it off: Meta's webhook
# is turned away and nothing is sent. The worker sends WhatsApp replies, so it must be running, and
# videos need ffmpeg (deploy/install-ffmpeg.sh). `node dist/channels/connect.js <business-slug>`
# points the number at a business.
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# For owners connecting their own numbers in Settings (Meta's sign-up).
META_APP_ID=
WHATSAPP_SIGNUP_CONFIG_ID=

# QuickBooks, from PriceCharm's app on developer.intuit.com, so owners can bring in their invoices.
# Leave empty to keep it off. The app's redirect URI is <APP_ORIGIN>/api/v1/onboarding/quickbooks/callback.
# Development keys only reach sandbox companies; production keys need QUICKBOOKS_ENVIRONMENT=production.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=production

# Photos stay in /srv/quotient-api/shared/uploads on this server.
# Optional: a private S3 bucket that also gets each nightly database dump. The server's IAM role
# needs s3:PutObject on it. Left empty, the dumps stay on this server.
BACKUP_BUCKET=

# The legal entity, its postal address, and the US state whose laws govern the terms (such as
# Texas). All four appear in the privacy policy and terms of service.
OPERATOR_NAME=
OPERATOR_ADDRESS=
GOVERNING_LAW=
# A real inbox, such as hello@pricecharm.com. Replies to PriceCharm's emails come here, except that
# customers replying to a business's email reach its owner.
SUPPORT_EMAIL=
# Optional: who gets the week's numbers every Monday (node dist/metrics-report.js prints them).
METRICS_EMAIL=
# Optional: who gets an email when someone starts training a Charm, makes an account and adds a
# card. Without it they go to SUPPORT_EMAIL.
SIGNUPS_EMAIL=

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). Add the product domain to the widget's
# hostnames. Its site key goes in the GitHub variable TURNSTILE_SITE_KEY for the web build.
# Production refuses Cloudflare's published test keys.
TURNSTILE_SECRET_KEY=

# Sentry project for the API and worker. Production refuses to start without it.
SENTRY_DSN=
