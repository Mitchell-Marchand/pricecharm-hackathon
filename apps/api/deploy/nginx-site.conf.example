# Install as /etc/nginx/conf.d/quotient.conf, then nginx -t && systemctl reload nginx.
# First install only the port 80 server and issue the certificate (LAUNCH.md section 3), then add the
# two TLS servers. www.pricecharm.com and plain HTTP both redirect to https://pricecharm.com.
log_format quotient_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent $request_time';
server {
    listen 80;
    server_name pricecharm.com www.pricecharm.com;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://pricecharm.com$request_uri; }
}
server {
    listen 443 ssl;
    server_name www.pricecharm.com;
    ssl_certificate /etc/letsencrypt/live/pricecharm.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pricecharm.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    access_log off;
    return 301 https://pricecharm.com$request_uri;
}
server {
    listen 443 ssl;
    server_name pricecharm.com;
    ssl_certificate /etc/letsencrypt/live/pricecharm.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pricecharm.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    access_log /var/log/nginx/quotient-access.log quotient_safe;
    # Error logs can contain request targets; the owner-facing tokens are short-lived.
    # Restrict and rotate these logs; never enable debug request/body logging.
    error_log /var/log/nginx/quotient-error.log crit;
    client_max_body_size 10m;
    # Customers' walk-around videos, which the API takes up to 100 MB.
    location ~ ^/api/v1/chat/[^/]+/[^/]+/videos$ {
        client_max_body_size 110m;
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        proxy_buffering off;
        proxy_cache off;
    }
    location /api/v1/ {
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 90s;
        proxy_buffering off;
        proxy_cache off;
    }
    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 90s;
        proxy_buffering off;
    }
}
