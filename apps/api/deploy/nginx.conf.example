# Put this inside the server block for your product domain after configuring HTTPS.
# Use these locations for both the owner app and the public widget origin.
# Give the owner host its own host-only auth cookie; never share it across subdomains.
client_max_body_size 10m;

location /api/v1/ {
    proxy_pass http://127.0.0.1:4100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 65s;
    proxy_buffering off;
    proxy_cache off;
}

location / {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 65s;
    proxy_buffering off;
}
