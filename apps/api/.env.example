# Local development. Staging and production start from deploy/env.production.example instead.
APP_ENV=local
NODE_ENV=development
PORT=4100
APP_ORIGIN=http://localhost:3100
# Return email codes and links in API responses so local flows work without an inbox.
# Only honored on localhost; a deployed server refuses to start with it.
EXPOSE_DEV_TOKENS=1
# PriceCharm's own local MariaDB: `npm run db:start` (see docs/ops/database.md).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=quoting_engine
DB_USER=quoting_engine
DB_PASS=local-dev-only
DB_CONNECTION_LIMIT=5
# Set AI_PROVIDER=demo explicitly to use clearly labelled deterministic demo mode.
# Use keys that belong to PriceCharm's dev project/workspace, never another product's (docs/ops/ai-keys.md).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: a stronger model just for drafting quotes. Compare candidates with `npm run replay`.
OPENAI_DRAFT_MODEL=
ANTHROPIC_DRAFT_MODEL=
# Starting prices from other businesses in the same trade, for services an owner has never priced.
# Leave off until the Terms that allow it are live (see docs/pricing.md).
MARKET_PRICES=off
# Practice photos use OpenAI image generation even when chat uses Anthropic.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
AI_IMAGE_TIMEOUT_MS=120000
STRIPE_SECRET_KEY=

# Durable provider budgets count logical attempts, including failures, per UTC day.
# All AI calls together:
AI_DAILY_APP_LIMIT=1000
# Each business's own work (setup, past jobs, practice, its own test chats):
AI_DAILY_BUSINESS_LIMIT=100
# Customer chat on public links. It can't use the owner allowance above, and all customers together
# can't use more than AI_DAILY_CUSTOMER_APP_LIMIT, so owners always keep the rest of the app limit.
AI_DAILY_CUSTOMER_APP_LIMIT=600
AI_DAILY_BUSINESS_CUSTOMER_LIMIT=200
AI_DAILY_CUSTOMER_IP_LIMIT=60
# Setups that haven't signed up yet share their own pool, and each has a lifetime cap.
AI_DAILY_DRAFT_APP_LIMIT=400
AI_DRAFT_LIFETIME_LIMIT=150
# The live demo on the marketing site: all visitors together, and each visitor, per day.
# Each demo chat is also capped at 12 calls.
AI_DAILY_DEMO_LIMIT=300
AI_DAILY_DEMO_IP_LIMIT=40
AI_TIMEOUT_MS=25000
AI_MAX_OUTPUT_TOKENS=1200
# Private photo storage: leave S3_BUCKET empty for local UPLOAD_DIR storage.
UPLOAD_DIR=./var/uploads
S3_BUCKET=
S3_PREFIX=quotient/
AWS_REGION=us-east-1
# Behind exactly one local Nginx proxy; Nginx must overwrite X-Forwarded-For.
TRUST_PROXY=0

# Optional verified TLS for the shared database host (recommended across hosts).
DB_SSL=0
DB_SSL_CA_FILE=

# Transactional email: local only in development/test; SES in production.
MAIL_PROVIDER=local
SES_EMAIL_FROM=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key stable and backed up; pending email payloads are encrypted with it.
MAIL_ENCRYPTION_KEY=

# Billing. Production requires Stripe: a price for each plan and the meter that counts billed
# quotes. `npm run stripe:setup` creates them and prints these lines (deploy/COMMERCE.md).
BILLING_PROVIDER=local
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT_NAME=pricecharm_quotes
STRIPE_PRICE_PER_QUOTE=
STRIPE_PRICE_PER_ACCEPTED=
STRIPE_PRICE_EXTRA_QUOTES=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Plan prices in cents. These are the defaults; Stripe's prices must match them.
BILLING_PER_QUOTE_CENTS=200
BILLING_ACCEPTED_BASIS_POINTS=100
BILLING_ACCEPTED_MINIMUM_CENTS=100
BILLING_ACCEPTED_MAXIMUM_CENTS=2500
BILLING_MONTHLY_CENTS=4900
BILLING_YEARLY_CENTS=49900
BILLING_INCLUDED_QUOTES=100
BILLING_OVERAGE_CENTS=100
# Free quotes before fees start, for new accounts. 0 means every quote has a fee.
BILLING_TRIAL_QUOTES=0

# Real operator details displayed on public terms/privacy/support pages in production.
# OPERATOR_NAME is the legal entity, OPERATOR_ADDRESS its postal address, and GOVERNING_LAW the
# US state whose laws govern the terms (just the name, such as Texas).
OPERATOR_NAME=
OPERATOR_ADDRESS=
GOVERNING_LAW=
# Replies to PriceCharm's emails go here, except that customers reach the business's owner.
SUPPORT_EMAIL=
# Optional: who gets the week's numbers every Monday. `npm run metrics` prints them any time.
METRICS_EMAIL=

# Cloudflare Turnstile bot check on signup, the landing-page preview and new customer chats.
# Leave it empty locally to skip the check. Staging and production require it. The matching site
# key goes in the web app's NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Sentry error reports from the API and worker. Empty means off. Production requires it.
SENTRY_DSN=
