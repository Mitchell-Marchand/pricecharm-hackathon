NODE_ENV=development
PORT=4100
APP_ORIGIN=http://localhost:3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quotient_local
DB_USER=quotient_local
DB_PASS=
DB_CONNECTION_LIMIT=5
# Set AI_PROVIDER=demo explicitly to use clearly labelled deterministic demo mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
# Practice photos use OpenAI image generation even when chat uses Anthropic.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
AI_IMAGE_TIMEOUT_MS=120000
STRIPE_SECRET_KEY=

# Durable provider budgets count logical attempts, including failures.
AI_DAILY_BUSINESS_LIMIT=100
AI_DAILY_APP_LIMIT=1000
# Guest previews reserve one provider attempt before signup, including failures.
# These UTC-day limits also consume the shared AI_DAILY_APP_LIMIT allowance.
GUEST_PREVIEW_DAILY_APP_LIMIT=50
GUEST_PREVIEW_DAILY_IP_LIMIT=3
AI_TIMEOUT_MS=25000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_TURNS=40
# Private photo storage: leave S3_BUCKET empty for local UPLOAD_DIR storage.
UPLOAD_DIR=./var/uploads
S3_BUCKET=
S3_PREFIX=quotient/
AWS_REGION=us-east-1
# Behind exactly one local Nginx proxy; Nginx must overwrite X-Forwarded-For.
TRUST_PROXY=0

# Optional verified TLS for the shared database host (recommended across hosts).
DB_SSL=0
DB_SSL_CA_FILE=
AI_DOCUMENT_MAX_OUTPUT_TOKENS=4000

# Transactional email: local only in development/test; SES in production.
MAIL_PROVIDER=local
SES_EMAIL_FROM=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key stable and backed up; pending email payloads are encrypted with it.
MAIL_ENCRYPTION_KEY=

# Per-delivery billing. Production requires Stripe, including bounded free trials.
BILLING_PROVIDER=local
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_METER_EVENT_NAME=quotient_fee_cents
BILLING_TARIFF_VERSION=quote-percentage-v1
BILLING_FEE_BASIS_POINTS=100
BILLING_MINIMUM_FEE_CENTS=100
BILLING_MAXIMUM_FEE_CENTS=2500
BILLING_TRIAL_QUOTES=10
BILLING_TRIAL_DAYS=14

# Real operator details displayed on public terms/privacy/support pages in production.
OPERATOR_NAME=
SUPPORT_EMAIL=
