{
  "name": "@pricecharm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node --import tsx src/worker.ts",
    "migrate": "node --import tsx src/migrate.ts",
    "metrics": "node --import tsx src/metrics-report.ts",
    "test": "DOTENV_CONFIG_PATH=/dev/null EXPOSE_DEV_TOKENS=1 NODE_ENV=${NODE_ENV:-test} APP_ENV=${APP_ENV:-test} AI_PROVIDER=${AI_PROVIDER:-demo} MAIL_PROVIDER=${MAIL_PROVIDER:-local} BILLING_PROVIDER=${BILLING_PROVIDER:-local} node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json .prettierrc.json \"deploy/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json .prettierrc.json \"deploy/*.cjs\"",
    "ops": "node --import tsx src/ops.ts",
    "replay": "node --import tsx src/replay.ts",
    "ops:production": "node dist/ops.js --http",
    "stripe:setup": "node --import tsx src/stripe-setup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@meta-sam/parser": "0.1.0",
    "@pricecharm/trades": "0.1.0",
    "@sentry/node": "11.6.0",
    "cors": "^2.8.5",
    "disposable-email-domains-js": "1.26.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
